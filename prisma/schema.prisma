// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Models are added starting in Task 5. The datasource connection URL lives
// in prisma7.config.ts (Prisma 7 no longer allows url = env("...") here),
// sourced from DATABASE_URL / TEST_DATABASE_URL in .env.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
