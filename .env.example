# Copy this file to .env and adjust values for your machine. .env is gitignored.

# Postgres container credentials (docker-compose.yml's db service).
POSTGRES_USER=motomais
POSTGRES_PASSWORD=motomais

# Prisma datasource (read by prisma7.config.ts). Points at the `db` service
# from docker-compose.yml on localhost:5432, database `motomais`.
DATABASE_URL="postgresql://motomais:motomais@localhost:5432/motomais?schema=public"

# Second database on the same Postgres instance (created by
# docker/initdb/01-create-test-db.sql), used only by integration tests.
TEST_DATABASE_URL="postgresql://motomais:motomais@localhost:5432/motomais_test?schema=public"

# Secret used to sign/verify session JWTs.
JWT_SECRET=dev-secret-change-me

# Shared PIN/password for the balcão (counter) login.
BALCAO_SENHA=0000

# Public base URL of the app (used for links, QR code, absolute URLs).
APP_URL=http://localhost:3000

# Timezone for date/time handling across the app.
TZ=America/Fortaleza
